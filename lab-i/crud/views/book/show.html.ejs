<!DOCTYPE html>
<html>
<head>
    <title><%= book.title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="show">
    <div id="container">
        <header>
            <nav>
                <ul>
                    <li><a href="/">HOME</a></li>
                    <li><a href="/book">BOOKS</a></li>
                </ul>
            </nav>
        </header>

        <main>
            <h1><%= book.title %></h1>

            <article>
                <p><strong>Author:</strong> <%= book.author %></p>
                <p><strong>Year:</strong> <%= book.year %></p>
            </article>

            <ul class="action-list">
                <li><a href="/book">Back to list</a></li>
                <li><a href="/book/<%= book.id %>/edit">Edit</a></li>
            </ul>
        </main>

        <footer>
            <p>&copy; 2026 - My Book Application</p>
        </footer>
    </div>
</body>
</html>