<div class="form-group">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= book && book.title ? book.title : '' %>">
</div>

<div class="form-group">
    <label for="author">Author</label>
    <input type="text" id="author" name="author" value="<%= book && book.author ? book.author : '' %>">
</div>

<div class="form-group">
    <label for="year">Year</label>
    <input type="number" id="year" name="year" value="<%= book && book.year ? book.year : '' %>">
</div>

<div class="form-group">
    <label></label>
    <input type="submit" value="Submit">
</div>